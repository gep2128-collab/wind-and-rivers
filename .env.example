# Copia este archivo como .env y pon tus claves ahí. .env está en .gitignore y nunca se sube.
# Copy this file to .env and put your keys there. .env is gitignored and never committed.
# Formato: NOMBRE=valor  (sin espacios ni comillas / no spaces or quotes)

# NASA FIRMS — https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Copernicus (CDS, ADS, EWDS: la misma clave) — https://cds.climate.copernicus.eu/profile  → "API Token"
COPERNICUS_KEY=

# NASA Earthdata — https://urs.earthdata.nasa.gov/profile → "Generate Token"
EARTHDATA_TOKEN=

# IUCN Red List API v4 — https://api.iucnredlist.org/ → inicia sesión, el token está en tu perfil
IUCN_API_TOKEN=

# GBIF — tu usuario y contraseña de gbif.org
GBIF_USER=
GBIF_PASSWORD=
